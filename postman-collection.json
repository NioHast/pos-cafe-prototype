{
  "info": {
    "name": "POS Cafe - API Testing",
    "description": "Collection untuk testing fitur admin panel tanpa frontend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login Kasir",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('token', jsonData.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kasir@cafe.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@student.ac.id\",\n  \"password\": \"password123\",\n  \"nim\": \"2024001\",\n  \"faculty\": \"Engineering\",\n  \"major\": \"Computer Science\",\n  \"enrollment_year\": 2024\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register-student",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register-student"]
            }
          }
        }
      ]
    },
    {
      "name": "Menu",
      "item": [
        {
          "name": "Get Menu List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/menu",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders - Kasir",
      "item": [
        {
          "name": "Create Order (Kasir)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cashier_id\": 2,\n  \"customer_name\": \"Walk-in Customer\",\n  \"table_number\": null,\n  \"payment_method\": \"cash\",\n  \"items\": [\n    {\n      \"menu_id\": 1,\n      \"quantity\": 2,\n      \"handled_by\": 2\n    },\n    {\n      \"menu_id\": 3,\n      \"quantity\": 1,\n      \"handled_by\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Order Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders/1",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders - Customer",
      "item": [
        {
          "name": "Create Order (Customer Self-Order)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Jane Smith\",\n  \"customer_phone\": \"081234567890\",\n  \"table_number\": \"A5\",\n  \"payment_method\": \"qris\",\n  \"items\": [\n    {\n      \"menu_id\": 1,\n      \"quantity\": 1\n    },\n    {\n      \"menu_id\": 2,\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Student Profile",
      "item": [
        {
          "name": "Get Student Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/student/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "student", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Testing Utilities",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/test/users",
              "host": ["{{base_url}}"],
              "path": ["api", "test", "users"]
            }
          }
        },
        {
          "name": "Get Recent Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/test/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "test", "orders"]
            }
          }
        }
      ]
    }
  ]
}
